<Window x:Class="TabularDB.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="850" Width="1360"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16" Background="#FF172554">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="TabularDB" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
                <Grid Grid.Column="1">
                    <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}"
                              DisplayMemberPath="Name" VerticalContentAlignment="Center"
                              IsEnabled="{Binding HasDatabases}" />
                    <TextBlock Text="{Binding DatabaseEmptyStateMessage}"
                               Visibility="{Binding DatabaseEmptyStateVisibility}"
                               Foreground="#FFE2E8F0" VerticalAlignment="Center"
                               Margin="8,0" IsHitTestVisible="False" />
                </Grid>
                <TextBox Grid.Column="2" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" ToolTip="New database name" MinWidth="180" Margin="8,0" VerticalContentAlignment="Center" />
                <Button Grid.Column="3" Content="Create database" Command="{Binding CreateDatabaseCommand}" Margin="4,0" Padding="10,5" />
                <Button Grid.Column="4" Content="Delete database" Command="{Binding DeleteDatabaseCommand}" IsEnabled="{Binding HasSelectedDatabase}" Margin="4,0" Padding="10,5" />
                <Button Grid.Column="5" Content="Save database" Command="{Binding SaveDatabaseCommand}" IsEnabled="{Binding HasSelectedDatabase}" Margin="4,0" Padding="10,5" />
                <Button Grid.Column="6" Content="Load database" Command="{Binding LoadDatabaseCommand}" Margin="4,0" Padding="10,5" />
                <Button Grid.Column="7" Content="Refresh" Command="{Binding RefreshDatabasesCommand}" HorizontalAlignment="Right" Margin="12,0,0,0" Padding="10,5" />
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="10,7" Background="#FFF1F5F9">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="14" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Tables" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid MinHeight="150">
                            <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                                     DisplayMemberPath="Name" MinHeight="150" IsEnabled="{Binding HasTables}" />
                            <TextBlock Text="{Binding TableEmptyStateMessage}"
                                       Visibility="{Binding TableEmptyStateVisibility}"
                                       Foreground="#FF64748B" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="12" IsHitTestVisible="False" />
                        </Grid>
                        <Button Content="Delete selected table" Command="{Binding DeleteTableCommand}"
                                IsEnabled="{Binding HasSelectedTable}" Margin="0,8,0,16" Padding="8" />
                        <Separator />
                        <TextBlock Text="Create a table" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <TextBlock Text="Table name" />
                        <TextBox Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="5" />
                        <TextBlock Text="Column schema" FontWeight="SemiBold" Margin="0,4,0,5" />
                        <TextBlock Text="Mark one or more columns as primary keys; together they uniquely identify a row."
                                   Foreground="#FF475569" TextWrapping="Wrap" Margin="0,0,0,5" />
                        <ListBox ItemsSource="{Binding NewTableColumns}"
                                 SelectedItem="{Binding SelectedTableColumn}"
                                 BorderThickness="0" MaxHeight="210">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Column name" Padding="5" MinWidth="200" />
                                        <ComboBox Grid.Row="1" Width="145" HorizontalAlignment="Left" Margin="0,5,0,0"
                                                  ItemsSource="{Binding DataContext.ColumnTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedType}"
                                                  DisplayMemberPath="DisplayName" />
                                        <CheckBox Grid.Row="1" Content="Primary key" IsChecked="{Binding IsPrimaryKey}"
                                                  ToolTip="Include this column in the unique row identifier." Margin="155,5,0,0"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Add column" Command="{Binding AddTableColumnCommand}" Padding="8,5" Margin="0,0,8,0" />
                            <Button Content="Remove selected" Command="{Binding RemoveTableColumnCommand}" Padding="8,5" />
                        </WrapPanel>
                        <Button Content="Create table" Command="{Binding CreateTableCommand}"
                                IsEnabled="{Binding HasSelectedDatabase}" Padding="8" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding RowsTable.DefaultView}" SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="True" AutoGeneratingColumn="OnAutoGeneratingColumn"
                          ColumnReordered="OnColumnReordered"
                          IsReadOnly="True" CanUserReorderColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" />
                <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Row values" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Money intervals use minimum..maximum, for example 5.00..8.25."
                                   Foreground="#FF475569" Margin="0,0,0,8" />
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RowInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DataType}" Foreground="#FF475569" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding InputHint}" Padding="4" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="New row" Command="{Binding NewRowCommand}" Margin="0,0,8,0" Padding="10,5" />
                            <Button Content="Save row" Command="{Binding SaveRowCommand}" Margin="0,0,8,0" Padding="10,5" />
                            <Button Content="Delete selected row" Command="{Binding DeleteRowCommand}" Padding="10,5" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Column schema" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid MinWidth="180" Margin="0,0,8,0">
                            <ComboBox ItemsSource="{Binding SelectedTable.Columns}" SelectedItem="{Binding SelectedColumn}"
                                      DisplayMemberPath="Name" IsEnabled="{Binding HasColumns}" />
                            <TextBlock Text="{Binding ColumnEmptyStateMessage}"
                                       Visibility="{Binding ColumnEmptyStateVisibility}"
                                       Foreground="#FF64748B" FontSize="11" VerticalAlignment="Center"
                                       Margin="6,0" IsHitTestVisible="False" />
                        </Grid>
                        <TextBox Text="{Binding ColumnName, UpdateSourceTrigger=PropertyChanged}" ToolTip="New column name" MinWidth="180" Padding="5" Margin="0,0,8,0" />
                        <Button Content="Rename" Command="{Binding RenameColumnCommand}" IsEnabled="{Binding HasColumns}" Margin="0,0,10,0" Padding="9,5" />
                        <TextBlock Text="Drag a column header above to change its order." Foreground="#FF475569" VerticalAlignment="Center" />
                    </WrapPanel>
                </Border>
                <TextBlock Grid.Row="3" Text="Money accepts up to two decimal places and a maximum magnitude of 10,000,000,000,000.00. Money intervals use minimum..maximum." Foreground="#FF475569" TextWrapping="Wrap" Margin="0,9,0,0" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
